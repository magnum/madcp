<header class="mb-10">
  <p class="mb-2 text-sm font-semibold uppercase tracking-[0.25em] text-sky-400">Multi-adapter MCP</p>
  <h1 class="text-4xl font-bold tracking-tight">MADCP integrations</h1>
  <p class="mt-3 max-w-2xl text-slate-400">
    Each integration has an independent MCP endpoint, OAuth issuer, credentials, and write-method policy.
  </p>
</header>

<div class="grid gap-5 md:grid-cols-2">
  <% integrations.each do |item| %>
    <% status = item.auth_status %>
    <article class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-2xl font-semibold"><%= h item.display_name %></h2>
          <p class="mt-2 text-sm text-slate-400"><%= h item.description %></p>
        </div>
        <span class="rounded-full px-3 py-1 text-xs font-semibold <%= status[:authenticated] ? "bg-emerald-500/15 text-emerald-300" : "bg-amber-500/15 text-amber-300" %>">
          <%= status[:authenticated] ? "authenticated" : "not authenticated" %>
        </span>
      </div>

      <dl class="mt-6 space-y-2 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-slate-500">server_id</dt>
          <dd class="font-mono"><%= h item.id %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-500">write methods</dt>
          <dd><%= item.allow_write_methods? ? "enabled" : "disabled" %></dd>
        </div>
      </dl>

      <div class="mt-6 grid grid-cols-2 gap-3">
        <a class="rounded-lg bg-sky-500 px-4 py-2 text-center font-semibold text-slate-950 hover:bg-sky-400" href="/servers/<%= h item.id %>/auth">Authentication</a>
        <a class="rounded-lg border border-slate-700 px-4 py-2 text-center font-semibold hover:bg-slate-800" href="/servers/<%= h item.id %>/tools">Tools JSON</a>
      </div>

      <p class="mt-4 break-all rounded-lg bg-slate-950 p-3 font-mono text-xs text-slate-400">
        <%= h "#{public_url}/servers/#{item.id}/mcp" %>
      </p>
    </article>
  <% end %>
</div>
