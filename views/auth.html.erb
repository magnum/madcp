<div class="mx-auto max-w-3xl">
  <a class="font-medium underline decoration-stone-400 underline-offset-4 hover:decoration-stone-950 dark:decoration-zinc-600 dark:hover:decoration-zinc-100"
     href="/servers/">← All integrations</a>
  <div class="mt-8 flex flex-col gap-5 border-b border-stone-300 pb-8 dark:border-zinc-700 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-semibold uppercase tracking-widest text-stone-500 dark:text-zinc-400">Authentication</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight"><%= h integration.display_name %></h1>
    </div>
    <% status = integration.auth_status %>
    <span class="w-fit shrink-0 whitespace-nowrap rounded-full border px-4 py-2 font-semibold <%= status[:authenticated] ? "border-emerald-700 bg-emerald-50 text-emerald-900 dark:border-emerald-700 dark:bg-emerald-950 dark:text-emerald-100" : "border-amber-700 bg-amber-50 text-amber-950 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-100" %>">
      <%= status[:authenticated] ? "Authenticated" : "Not authenticated" %>
    </span>
  </div>

  <% if error %>
    <div class="mt-6 rounded-lg border border-red-700 bg-red-50 p-4 text-red-950 dark:bg-red-950 dark:text-red-100" role="alert"><%= h error %></div>
  <% end %>
  <% if message %>
    <div class="mt-6 rounded-lg border border-emerald-700 bg-emerald-50 p-4 text-emerald-950 dark:bg-emerald-950 dark:text-emerald-100" role="status"><%= h message %></div>
  <% end %>

  <div class="mt-6 text-stone-700 dark:text-zinc-300">
    <% if status[:account_id] %>
      Account <span class="font-mono font-semibold text-stone-950 dark:text-zinc-100"><%= h status[:account_id] %></span>
    <% end %>
  </div>

  <% auth_help = integration.auth_help_content %>
  <% if auth_help %>
    <section class="mt-10 border-b border-stone-300 pb-8 dark:border-zinc-700" aria-labelledby="auth-help-title">
      <h2 class="text-2xl font-bold" id="auth-help-title"><%= h auth_help[:title] %></h2>
      <% if auth_help[:description] %>
        <p class="mt-3 max-w-2xl leading-7 text-stone-700 dark:text-zinc-300"><%= h auth_help[:description] %></p>
      <% end %>
      <% if auth_help[:steps]&.any? %>
        <ol class="mt-6 space-y-3">
          <% auth_help[:steps].each_with_index do |step, index| %>
            <li class="flex gap-4">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-stone-950 font-semibold text-stone-50 dark:bg-zinc-100 dark:text-zinc-950"><%= index + 1 %></span>
              <span class="pt-0.5 leading-7"><%= h step %></span>
            </li>
          <% end %>
        </ol>
      <% end %>
      <% if auth_help[:commands]&.any? %>
        <div class="mt-7 space-y-4">
          <% auth_help[:commands].each do |command| %>
            <div data-command>
              <p class="mb-2 font-semibold"><%= h command[:label] %></p>
              <div class="flex min-w-0 items-center gap-3 rounded-lg border border-stone-300 bg-stone-100 p-2 pl-4 dark:border-zinc-700 dark:bg-zinc-900">
                <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap py-2 font-mono"><%= h command[:value] %></code>
                <button class="shrink-0 rounded-md border border-stone-400 bg-stone-50 px-3 py-2 font-semibold hover:bg-stone-200 focus:outline-none focus:ring-2 focus:ring-stone-950 dark:border-zinc-600 dark:bg-zinc-800 dark:hover:bg-zinc-700 dark:focus:ring-zinc-100"
                        type="button"
                        onclick="copyAuthCommand(this)">Copy</button>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      <% if auth_help[:note] %>
        <p class="mt-6 rounded-lg bg-amber-50 p-4 leading-7 text-amber-950 dark:bg-amber-950 dark:text-amber-100"><%= h auth_help[:note] %></p>
      <% end %>
    </section>
  <% end %>

  <form class="mt-10 space-y-6"
        method="post"
        action="/servers/<%= h integration.id %>/auth/<%= state ? "callback" : "credentials" %>">
    <% if state %>
      <input type="hidden" name="state" value="<%= h state %>">
    <% end %>

    <div>
      <h2 class="text-2xl font-bold">MADCP operator</h2>
      <p class="mt-2 leading-7 text-stone-700 dark:text-zinc-300">Confirm the operator credentials before changing integration secrets.</p>
    </div>
    <div>
      <label class="mb-2 block font-semibold" for="username">MADCP username</label>
      <input class="w-full rounded-lg border border-stone-400 bg-stone-50 px-4 py-3 text-stone-950 focus:border-stone-950 focus:outline-none focus:ring-2 focus:ring-stone-950/20 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100"
             id="username" name="username" autocomplete="username" required>
    </div>
    <div>
      <label class="mb-2 block font-semibold" for="password">MADCP password</label>
      <input class="w-full rounded-lg border border-stone-400 bg-stone-50 px-4 py-3 text-stone-950 focus:border-stone-950 focus:outline-none focus:ring-2 focus:ring-stone-950/20 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100"
             id="password" name="password" type="password" autocomplete="current-password" required>
    </div>

    <% if integration.auth_fields.any? %>
      <div class="border-t border-stone-300 pt-8 dark:border-zinc-700">
        <h2 class="text-2xl font-bold">Integration credentials</h2>
        <p class="mt-2 leading-7 text-stone-700 dark:text-zinc-300">
          Fields are pre-filled from the current environment or stored credentials.
          Leave them as-is to keep the values, edit to replace, or clear a field and save to remove it.
        </p>
      </div>
    <% end %>
    <% integration.auth_fields.each do |field| %>
      <% field_value = integration.auth_field_value(field) %>
      <div>
        <label class="mb-2 block font-semibold" for="<%= h field[:name] %>"><%= h field[:label] %></label>
        <% if field[:help] %>
          <p class="mb-3 leading-7 text-stone-600 dark:text-zinc-400"><%= h field[:help] %></p>
        <% end %>
        <% if field[:type] == "textarea" %>
          <textarea class="h-56 w-full rounded-lg border border-stone-400 bg-stone-50 px-4 py-3 font-mono text-stone-950 focus:border-stone-950 focus:outline-none focus:ring-2 focus:ring-stone-950/20 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100"
                    id="<%= h field[:name] %>"
                    name="<%= h field[:name] %>"
                    spellcheck="false"
                    <%= "required" if field[:required] %>><%= h field_value %></textarea>
        <% else %>
          <input class="w-full rounded-lg border border-stone-400 bg-stone-50 px-4 py-3 text-stone-950 focus:border-stone-950 focus:outline-none focus:ring-2 focus:ring-stone-950/20 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100 dark:focus:border-zinc-100"
                 id="<%= h field[:name] %>"
                 name="<%= h field[:name] %>"
                 type="<%= h field[:type] || "text" %>"
                 value="<%= h field_value %>"
                 <%= "required" if field[:required] %>>
        <% end %>
      </div>
    <% end %>

    <button class="w-full rounded-lg bg-stone-950 px-5 py-3 font-bold text-stone-50 hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-stone-950 focus:ring-offset-2 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-zinc-300 dark:focus:ring-zinc-100 dark:focus:ring-offset-zinc-950"
            type="submit">
      <%= state ? "Authorize MCP client" : "Update integration credentials" %>
    </button>

    <% if integration.oauth_token_retrieval? %>
      <div class="border-t border-stone-300 pt-8 dark:border-zinc-700">
        <h2 class="text-2xl font-bold">Provider OAuth</h2>
        <p class="mt-2 leading-7 text-stone-700 dark:text-zinc-300">
          Retrieve a token through the provider's OAuth flow. Register this exact callback URL:
        </p>
        <div class="mt-4 flex min-w-0 items-center gap-3 rounded-lg border border-stone-300 bg-stone-100 p-2 pl-4 dark:border-zinc-700 dark:bg-zinc-900"
             data-command>
          <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap py-2 font-mono"><%= h "#{public_url}/servers/#{integration.id}/oauth_callback" %></code>
          <button class="shrink-0 rounded-md border border-stone-400 bg-stone-50 px-3 py-2 font-semibold hover:bg-stone-200 dark:border-zinc-600 dark:bg-zinc-800 dark:hover:bg-zinc-700"
                  type="button"
                  onclick="copyAuthCommand(this)">Copy</button>
        </div>
        <button class="mt-5 w-full rounded-lg border-2 border-stone-950 px-5 py-3 font-bold hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-950 focus:ring-offset-2 dark:border-zinc-100 dark:hover:bg-zinc-900 dark:focus:ring-zinc-100 dark:focus:ring-offset-zinc-950"
                type="submit"
                formaction="/servers/<%= h integration.id %>/oauth"
                formmethod="post">
          Retrieve OAuth token
        </button>
      </div>
    <% end %>
  </form>

  <div class="mt-10 flex flex-col gap-4 border-t border-stone-300 pt-6 dark:border-zinc-700 sm:flex-row sm:justify-between">
    <a class="font-medium underline decoration-stone-400 underline-offset-4 hover:decoration-stone-950 dark:decoration-zinc-600 dark:hover:decoration-zinc-100"
       href="/servers/<%= h integration.id %>/tools">View tools</a>
    <a class="font-medium text-red-800 underline decoration-red-300 underline-offset-4 hover:decoration-red-800 dark:text-red-300 dark:decoration-red-900 dark:hover:decoration-red-300"
       href="/servers/<%= h integration.id %>/auth/logout">Logout / revoke</a>
  </div>
</div>
