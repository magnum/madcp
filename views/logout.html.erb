<div class="mx-auto max-w-2xl">
  <a class="font-medium underline decoration-stone-400 underline-offset-4 hover:decoration-stone-950 dark:decoration-zinc-600 dark:hover:decoration-zinc-100"
     href="/servers/<%= h integration.id %>/auth">← Authentication</a>
  <div class="mt-8 border-b border-stone-300 pb-8 dark:border-zinc-700">
    <p class="text-sm font-semibold uppercase tracking-widest text-stone-500 dark:text-zinc-400">Session management</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Logout from <%= h integration.display_name %></h1>
  </div>

  <% if error %>
    <div class="mt-6 rounded-lg border border-red-700 bg-red-50 p-4 text-red-950 dark:bg-red-950 dark:text-red-100" role="alert"><%= h error %></div>
  <% end %>
  <% if message %>
    <div class="mt-6 rounded-lg border border-emerald-700 bg-emerald-50 p-4 text-emerald-950 dark:bg-emerald-950 dark:text-emerald-100" role="status"><%= h message %></div>
  <% end %>

  <form class="mt-10 space-y-6" method="post">
    <p class="leading-7 text-stone-700 dark:text-zinc-300">
      You are signed in with MadCP HTTP Basic Auth. Confirm to revoke MCP client OAuth sessions for this integration.
    </p>
    <label class="flex items-start gap-3 rounded-lg border border-stone-300 bg-stone-100 p-4 dark:border-zinc-700 dark:bg-zinc-900">
      <input class="mt-1 h-5 w-5 accent-stone-950 dark:accent-zinc-100" type="checkbox" name="clear_integration" value="1">
      <span>
        <strong class="block">Also clear <%= h integration.display_name %> credentials</strong>
        <span class="mt-1 block leading-7 text-stone-600 dark:text-zinc-400">Otherwise only MadCP OAuth sessions are revoked.</span>
      </span>
    </label>
    <button class="w-full rounded-lg bg-red-800 px-5 py-3 font-bold text-stone-50 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-800 focus:ring-offset-2 dark:bg-red-700 dark:hover:bg-red-600 dark:focus:ring-offset-zinc-950"
            type="submit">
      Revoke sessions
    </button>
  </form>
</div>
