<div class="mx-auto max-w-3xl">
  <a class="font-medium underline decoration-stone-400 underline-offset-4 hover:decoration-stone-950 dark:decoration-zinc-600 dark:hover:decoration-zinc-100"
     href="/servers/<%= h integration.id %>/auth">← Authentication</a>
  <div class="mt-8 border-b border-stone-300 pb-8 dark:border-zinc-700">
    <p class="font-semibold uppercase tracking-widest text-stone-500 dark:text-zinc-400">Provider callback</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight"><%= h integration.display_name %> OAuth result</h1>
    <div class="mt-5 flex min-w-0 items-center gap-3 rounded-lg bg-stone-100 p-2 pl-4 dark:bg-zinc-900"
         data-command>
      <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap py-2 font-mono"><%= h callback_url %></code>
      <button class="shrink-0 rounded-md border border-stone-400 bg-stone-50 px-3 py-2 font-semibold hover:bg-stone-200 dark:border-zinc-600 dark:bg-zinc-800 dark:hover:bg-zinc-700"
              type="button"
              onclick="copyAuthCommand(this)">Copy</button>
    </div>
  </div>

  <% body = oauth_result.is_a?(Hash) ? (oauth_result[:body] || oauth_result["body"]) : nil %>
  <% token_body = body.is_a?(Hash) ? body : {} %>
  <% access_token = token_body["access_token"] || token_body[:access_token] %>
  <% refresh_token = token_body["refresh_token"] || token_body[:refresh_token] %>
  <% token_json_text = body.is_a?(Hash) ? JSON.pretty_generate(body) : "" %>

  <% if token_saved %>
    <div class="mt-8 rounded-lg border border-emerald-700 bg-emerald-50 p-5 text-emerald-950 dark:bg-emerald-950 dark:text-emerald-100"
         role="status">
      <p class="font-semibold">Token saved into MadCP.</p>
      <p class="mt-2 leading-7">
        Access token and the full OAuth JSON (including refresh token when present) are stored.
        You can return to the authentication page — the token field is already filled.
      </p>
      <a class="mt-4 inline-block font-bold underline decoration-emerald-700 underline-offset-4"
         href="/servers/<%= h integration.id %>/auth">Go to authentication form</a>
    </div>
  <% elsif token_save_error %>
    <div class="mt-8 rounded-lg border border-amber-700 bg-amber-50 p-5 text-amber-950 dark:bg-amber-950 dark:text-amber-100"
         role="alert">
      <p class="font-semibold">Automatic save failed</p>
      <p class="mt-2 leading-7"><%= h token_save_error %></p>
      <p class="mt-2 leading-7">Paste the access token below to save it into the MadCP auth form.</p>
    </div>
  <% end %>

  <% show_save_form = !token_saved && (access_token || refresh_token || token_save_error || oauth_result) %>
  <% if show_save_form %>
    <section class="mt-8 rounded-lg border border-stone-400 bg-stone-50 p-6 dark:border-zinc-600 dark:bg-zinc-900">
      <h2 class="text-2xl font-bold">Save token into MadCP</h2>
      <p class="mt-3 leading-7 text-stone-700 dark:text-zinc-300">
        Read the token from the above output and set it in the token field below.
        Saving writes it into the MadCP authentication form for this integration
        (and stores the full OAuth JSON when available).
      </p>

      <form class="mt-6 space-y-5"
            method="post"
            action="/servers/<%= h integration.id %>/auth/save_oauth_token">
        <div>
          <label class="mb-2 block font-semibold" for="access_token">Access token</label>
          <textarea class="h-28 w-full rounded-lg border border-stone-400 bg-stone-50 px-4 py-3 font-mono text-stone-950 focus:border-stone-950 focus:outline-none focus:ring-2 focus:ring-stone-950/20 dark:border-zinc-600 dark:bg-zinc-950 dark:text-zinc-100"
                    id="access_token"
                    name="access_token"
                    spellcheck="false"
                    required><%= h access_token.to_s %></textarea>
        </div>
        <% if !token_json_text.empty? %>
          <input type="hidden" name="token_json" value="<%= h token_json_text %>">
        <% else %>
          <div>
            <label class="mb-2 block font-semibold" for="token_json">Full OAuth JSON (optional)</label>
            <p class="mb-2 leading-7 text-stone-600 dark:text-zinc-400">
              Paste the upstream token response body to keep the refresh token too.
            </p>
            <textarea class="h-40 w-full rounded-lg border border-stone-400 bg-stone-50 px-4 py-3 font-mono text-stone-950 focus:border-stone-950 focus:outline-none focus:ring-2 focus:ring-stone-950/20 dark:border-zinc-600 dark:bg-zinc-950 dark:text-zinc-100"
                      id="token_json"
                      name="token_json"
                      spellcheck="false"></textarea>
          </div>
        <% end %>
        <button class="w-full rounded-lg bg-stone-950 px-5 py-3 font-bold text-stone-50 hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-stone-950 focus:ring-offset-2 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-zinc-300 dark:focus:ring-zinc-100 dark:focus:ring-offset-zinc-950"
                type="submit">
          Save token and return to authentication
        </button>
      </form>
    </section>
  <% end %>

  <% if access_token || refresh_token %>
    <section class="mt-8 rounded-lg border border-emerald-700 bg-emerald-50 p-6 text-emerald-950 dark:bg-emerald-950 dark:text-emerald-100">
      <h2 class="text-2xl font-bold">Copy tokens now</h2>
      <p class="mt-2 leading-7">Keep a backup copy if you want — MadCP also stores them when save succeeds.</p>
      <% { "Access token" => access_token, "Refresh token" => refresh_token }.each do |label, token| %>
        <% next unless token %>
        <div class="mt-5" data-command>
          <label class="block font-semibold"><%= h label %></label>
          <textarea class="mt-2 h-28 w-full resize-y rounded-lg border border-emerald-800 bg-stone-50 p-4 font-mono text-stone-950 dark:bg-zinc-950 dark:text-zinc-100"
                    readonly><%= h token %></textarea>
          <button class="mt-2 rounded-md border border-emerald-800 bg-stone-50 px-4 py-2 font-semibold text-emerald-950 hover:bg-emerald-100 dark:bg-zinc-900 dark:text-emerald-100 dark:hover:bg-zinc-800"
                  type="button"
                  onclick="copyAuthCommand(this)">Copy <%= h label.downcase %></button>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="mt-8 border-t border-stone-300 pt-8 dark:border-zinc-700">
    <h2 class="text-2xl font-bold">Callback query parameters</h2>
    <textarea class="mt-4 h-48 w-full resize-y rounded-lg border border-stone-300 bg-stone-100 p-4 font-mono text-stone-950 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
              readonly><%= h JSON.pretty_generate(oauth_params) %></textarea>
  </section>

  <% if oauth_result %>
    <section class="mt-8 border-t border-stone-300 pt-8 dark:border-zinc-700">
      <h2 class="text-2xl font-bold">Upstream token response</h2>
      <% status = oauth_result.is_a?(Hash) ? (oauth_result[:status] || oauth_result["status"]) : nil %>
      <% upstream_headers = oauth_result.is_a?(Hash) ? (oauth_result[:headers] || oauth_result["headers"] || {}) : {} %>
      <p class="mt-3">Status: <span class="font-mono font-semibold"><%= h status || "not available" %></span></p>
      <h3 class="mt-6 text-xl font-bold">Headers</h3>
      <textarea class="mt-3 h-40 w-full resize-y rounded-lg border border-stone-300 bg-stone-100 p-4 font-mono text-stone-950 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
                readonly><%= h JSON.pretty_generate(upstream_headers) %></textarea>
      <h3 class="mt-6 text-xl font-bold">Body</h3>
      <textarea class="mt-3 h-64 w-full resize-y rounded-lg border border-stone-300 bg-stone-100 p-4 font-mono text-stone-950 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
                readonly><%= h JSON.pretty_generate(body || oauth_result) %></textarea>
    </section>
  <% end %>
</div>
