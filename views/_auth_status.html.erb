<%
  ok = status[:authenticated]
  detail =
    if ok
      [status[:email], status[:username], status[:workspace_name], status[:account_id], status[:source]]
        .compact.map(&:to_s).reject(&:empty?).first
    else
      status[:error]
    end
  badge_base = "inline-flex h-10 w-10 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-lg border font-semibold md:w-auto md:px-4"
  show_actions = defined?(actions) ? actions : false
%>
<div class="flex shrink-0 flex-col items-end gap-2"
     data-auth-status
     data-server-id="<%= h server_id %>">
  <div class="flex flex-nowrap items-center justify-end gap-2">
    <span
      data-auth-badge-ok
      class="<%= badge_base %> border-emerald-700 bg-emerald-50 text-emerald-900 dark:border-emerald-700 dark:bg-emerald-950 dark:text-emerald-100 <%= ok ? "" : "hidden" %>"
      aria-label="Authenticated"
      title="Authenticated">
      <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 12.75 11.25 15 15 9.75" />
        <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <span class="hidden md:inline">Authenticated</span>
    </span>
    <span
      data-auth-badge-bad
      class="<%= badge_base %> border-amber-700 bg-amber-50 text-amber-950 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-100 <%= ok ? "hidden" : "" %>"
      aria-label="Not authenticated"
      title="Not authenticated">
      <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
      </svg>
      <span class="hidden md:inline">Not authenticated</span>
    </span>
    <button
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-stone-300 bg-stone-50 text-stone-950 hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-950 focus:ring-offset-2 disabled:opacity-50 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100 dark:hover:bg-zinc-900 dark:focus:ring-zinc-100 dark:focus:ring-offset-zinc-950"
      type="button"
      data-auth-refresh
      aria-label="Refresh authentication status"
      title="Refresh authentication status">
      <svg class="h-5 w-5" data-auth-refresh-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12a9 9 0 1 1-2.64-6.36" />
        <path d="M21 3v6h-6" />
      </svg>
    </button>
    <% if show_actions %>
      <a class="inline-flex h-10 w-10 shrink-0 items-center justify-center gap-2 rounded-lg bg-stone-950 font-bold text-stone-50 hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-stone-950 focus:ring-offset-2 md:w-auto md:px-4 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-zinc-300 dark:focus:ring-zinc-100 dark:focus:ring-offset-zinc-950"
         href="/servers/<%= h server_id %>/auth"
         aria-label="Authentication"
         title="Authentication">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
          <path d="M4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
        <span class="hidden md:inline">Auth</span>
      </a>
      <a class="inline-flex h-10 w-10 shrink-0 items-center justify-center gap-2 rounded-lg border-2 border-stone-950 font-bold hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-950 focus:ring-offset-2 md:w-auto md:px-4 dark:border-zinc-100 dark:hover:bg-zinc-900 dark:focus:ring-zinc-100 dark:focus:ring-offset-zinc-950"
         href="/servers/<%= h server_id %>/tools"
         aria-label="Tools JSON"
         title="Tools JSON">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8.25 7.5 4.5 12l3.75 4.5" />
          <path d="M15.75 7.5 19.5 12l-3.75 4.5" />
        </svg>
        <span class="hidden md:inline">json</span>
      </a>
    <% end %>
  </div>
  <p
    data-auth-detail
    class="max-w-xs text-right text-sm leading-6 text-stone-600 dark:text-zinc-400 <%= detail ? "" : "hidden" %>">
    <%= h detail.to_s %>
  </p>
</div>
