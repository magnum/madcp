<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= h title %></title>
    <script>
      (() => {
        let savedTheme = null;
        try { savedTheme = localStorage.getItem("madcp-theme"); } catch (_error) {}
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = { darkMode: "class" };
    </script>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-950 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <%= partial("site_header") %>
    <main class="mx-auto w-full max-w-6xl px-6 py-4">
      <%= content %>
    </main>
    <%= partial("site_footer") %>
    <%= partial("scripts") %>
  </body>
</html>
