<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= h title %></title>
    <script>
      (() => {
        let savedTheme = null;
        try { savedTheme = localStorage.getItem("madcp-theme"); } catch (_error) {}
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = { darkMode: "class" };
    </script>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-950 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <div class="mx-auto flex w-full max-w-6xl justify-end px-6 pt-6">
      <button
        class="rounded-full border border-stone-300 bg-stone-50 px-4 py-2 font-medium hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-950 focus:ring-offset-2 dark:border-zinc-700 dark:bg-zinc-950 dark:hover:bg-zinc-900 dark:focus:ring-zinc-100 dark:focus:ring-offset-zinc-950"
        id="theme-toggle"
        type="button"
        aria-label="Switch color theme">
        <span class="dark:hidden">Dark mode</span>
        <span class="hidden dark:inline">Light mode</span>
      </button>
    </div>
    <main class="mx-auto w-full max-w-6xl px-6 pb-28 pt-8">
      <%= content %>
    </main>
    <footer class="fixed inset-x-0 bottom-0 border-t border-stone-200 bg-stone-50/95 px-6 py-4 text-center text-stone-600 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/95 dark:text-zinc-400">
      Copyright <%= year %> - Antonio Molinari ·
      <a class="font-medium text-stone-950 underline decoration-stone-400 underline-offset-4 hover:decoration-stone-950 dark:text-zinc-100 dark:decoration-zinc-600 dark:hover:decoration-zinc-100"
         href="<%= h repo_url %>"
         target="_blank"
         rel="noopener noreferrer">madcp</a>
    </footer>
    <script>
      document.getElementById("theme-toggle").addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try { localStorage.setItem("madcp-theme", isDark ? "dark" : "light"); } catch (_error) {}
      });

      async function copyAuthCommand(button) {
        const source = button.closest("[data-command]").querySelector("code, textarea");
        const command = source.value || source.textContent;
        try {
          await navigator.clipboard.writeText(command);
        } catch (_error) {
          const input = document.createElement("textarea");
          input.value = command;
          input.style.position = "fixed";
          input.style.opacity = "0";
          document.body.appendChild(input);
          input.select();
          document.execCommand("copy");
          input.remove();
        }

        const copyIcon = button.querySelector("[data-copy-icon]");
        const copiedIcon = button.querySelector("[data-copied-icon]");
        if (copyIcon && copiedIcon) {
          copyIcon.classList.add("hidden");
          copiedIcon.classList.remove("hidden");
          window.setTimeout(() => {
            copiedIcon.classList.add("hidden");
            copyIcon.classList.remove("hidden");
          }, 1400);
          return;
        }

        const original = button.textContent;
        button.textContent = "Copied";
        window.setTimeout(() => { button.textContent = original; }, 1400);
      }
    </script>
  </body>
</html>
