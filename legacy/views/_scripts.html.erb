<script>
  document.getElementById("theme-toggle").addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("madcp-theme", isDark ? "dark" : "light"); } catch (_error) {}
  });

  async function refreshAuthStatus(button) {
    const root = button.closest("[data-auth-status]");
    if (!root) return;

    const serverId = root.dataset.serverId;
    const badgeOk = root.querySelector("[data-auth-badge-ok]");
    const badgeBad = root.querySelector("[data-auth-badge-bad]");
    const detail = root.querySelector("[data-auth-detail]");
    const icon = root.querySelector("[data-auth-refresh-icon]");
    button.disabled = true;
    if (icon) icon.classList.add("animate-spin");

    try {
      const response = await fetch(
        `/servers/${encodeURIComponent(serverId)}/auth/status?refresh=1`,
        {
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        },
      );
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const status = await response.json();
      const ok = !!status.authenticated;
      badgeOk.classList.toggle("hidden", !ok);
      badgeBad.classList.toggle("hidden", ok);
      const detailText = ok
        ? [status.email, status.username, status.workspace_name, status.account_id, status.source]
          .filter(Boolean)[0]
        : status.error;
      if (detailText) {
        detail.textContent = detailText;
        detail.classList.remove("hidden");
      } else {
        detail.textContent = "";
        detail.classList.add("hidden");
      }
    } catch (error) {
      if (detail) {
        detail.textContent = `Refresh failed: ${error.message || error}`;
        detail.classList.remove("hidden");
      }
    } finally {
      button.disabled = false;
      if (icon) icon.classList.remove("animate-spin");
    }
  }

  document.querySelectorAll("[data-auth-refresh]").forEach((button) => {
    button.addEventListener("click", () => refreshAuthStatus(button));
  });

  async function copyAuthCommand(button) {
    const source = button.closest("[data-command]").querySelector("code, textarea");
    const command = source.value || source.textContent;
    try {
      await navigator.clipboard.writeText(command);
    } catch (_error) {
      const input = document.createElement("textarea");
      input.value = command;
      input.style.position = "fixed";
      input.style.opacity = "0";
      document.body.appendChild(input);
      input.select();
      document.execCommand("copy");
      input.remove();
    }

    const copyIcon = button.querySelector("[data-copy-icon]");
    const copiedIcon = button.querySelector("[data-copied-icon]");
    if (copyIcon && copiedIcon) {
      copyIcon.classList.add("hidden");
      copiedIcon.classList.remove("hidden");
      window.setTimeout(() => {
        copiedIcon.classList.add("hidden");
        copyIcon.classList.remove("hidden");
      }, 1400);
      return;
    }

    const original = button.textContent;
    button.textContent = "Copied";
    window.setTimeout(() => { button.textContent = original; }, 1400);
  }
</script>
