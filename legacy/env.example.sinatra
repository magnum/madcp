# MadCP wrapper ---------------------------------------------------------------

# Required public HTTPS origin. No trailing slash.
MADCP_PUBLIC_URL=https://madcp.example.com
# App auth:
# - data/auth_tokens → Bearer tokens for MCP / optional UI Bearer
# - data/auth_users  → username/password for HTTP Basic Auth (UI)
# Pepper for password digests (required if auth_users has entries):
# MADCP_SECRET_KEY=
# Optional aliases / overrides:
# SECRET_KEY=
# MADCP_AUTH_TOKEN=
# MADCP_AUTH_TOKENS_PATH=data/auth_tokens
# MADCP_AUTH_USERS_PATH=data/auth_users
MADCP_ALLOW_WRITE=false 
MADCP_MAX_CHARS=100000
MADCP_REQUEST_LOG=logs/requests.logs
MADCP_REQUEST_LOG_MAX_CHARS=8000
MADCP_HOST_PORT=8765 
MADCP_HOST=0.0.0.0 
MADCP_PORT=8765 
MADCP_ALLOWED_HOSTS=madcp.example.com,localhost,127.0.0.1 
MADCP_ALLOWED_ORIGINS=https://madcp.example.com 

# HEY -------------------------------------------------------------------------
HEY_ALLOW_WRITE=false 
HEY_TIMEOUT=30 

# Basecamp --------------------------------------------------------------------
BASECAMP_ALLOW_WRITE=false 
BASECAMP_TOKEN= 
BASECAMP_ACCOUNT_ID= 
BASECAMP_TIMEOUT=30 

# Fatture in Cloud ------------------------------------------------------------
FATTUREINCLOUD_ALLOW_WRITE=false 
FATTUREINCLOUD_COMPANY_ID= # required
FATTUREINCLOUD_CLIENT_ID= # required
FATTUREINCLOUD_CLIENT_SECRET= # required
FATTUREINCLOUD_TOKEN= # optional
FATTUREINCLOUD_OAUTH_SCOPES=entity.clients:a entity.suppliers:a issued_documents.invoices:a issued_documents.credit_notes:a issued_documents.quotes:a issued_documents.proformas:a issued_documents.self_invoices:a received_documents:r situation:r taxes:r cashbook:r calendar:r archive:a # optional
FATTUREINCLOUD_TIMEOUT=30 

# Google Workspace ------------------------------------------------------------
GOOGLEWORKSPACE_ALLOW_WRITE=false
# Prefer pasting gws auth export --unmasked via /servers/googleworkspace/auth.
# Do not set GOOGLE_WORKSPACE_CLI_TOKEN in Docker: it overrides the refresh-token
# credentials file and expires in ~1 hour.
# GOOGLE_WORKSPACE_CLI_TOKEN=
# GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE=  # set automatically by the auth form
GOOGLE_WORKSPACE_CLI_CLIENT_ID= # optional
GOOGLE_WORKSPACE_CLI_CLIENT_SECRET= # optional
GOOGLE_WORKSPACE_CLI_CONFIG_DIR=/home/madcp/.config/gws
GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file
GOOGLE_WORKSPACE_PROJECT_ID= # recommended
GOOGLEWORKSPACE_TIMEOUT=60

# Toggl Track -----------------------------------------------------------------
TOGGLTRACK_ALLOW_WRITE=false
TOGGLTRACK_TOKEN= # optional
TOGGLTRACK_ORGANIZATION_ID= # optional
TOGGLTRACK_WORKSPACE_ID= # optional
TOGGLTRACK_TIMEOUT=30

# Bluesky ----------------------------------------------------------------------
BLUESKY_ALLOW_WRITE=false
BLUESKY_HANDLE= # optional
BLUESKY_APP_PASSWORD= # optional
BLUESKY_PDS_HOST= # optional, default https://bsky.social
BLUESKY_TIMEOUT=30

# Twitter / X -----------------------------------------------------------------
TWITTER_ALLOW_WRITE=false
TWITTER_CLIENT_ID= # required for OAuth retrieve
TWITTER_CLIENT_SECRET= # required for OAuth retrieve
TWITTER_TOKEN= # optional
TWITTER_OAUTH_SCOPES=tweet.read tweet.write users.read follows.read follows.write like.read like.write list.read bookmark.read bookmark.write offline.access # optional
TWITTER_TIMEOUT=30

# TeslaMate (PostgreSQL)
TESLAMATE_DATABASE_URL= # postgresql://teslamate_ro:password@host:5432/teslamate
TESLAMATE_REPORT_TIMEZONE=UTC # optional
TESLAMATE_STATEMENT_TIMEOUT_MS=30000 # optional
TESLAMATE_QUERY_TIMEOUT_MS=5000 # optional
TESLAMATE_CUSTOM_SQL_ROW_LIMIT=1000 # optional
