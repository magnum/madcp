# MADCP wrapper ---------------------------------------------------------------

# Public HTTPS origin exposed by your reverse proxy or tunnel. No trailing slash.
MADCP_PUBLIC_URL=https://madcp.example.com

# Credentials used on MADCP integration auth pages.
MADCP_OAUTH_USERNAME=admin
MADCP_OAUTH_PASSWORD=change-me

# Optional static bearer accepted by every integration in addition to OAuth.
# MADCP_AUTH_TOKEN=

# Read-only by default. Integrations can override this value below.
MADCP_ALLOW_WRITE_METHODS=false

# External Docker port; the internal container port remains 8765.
MADCP_HOST_PORT=8765
MADCP_HOST=0.0.0.0
MADCP_PORT=8765

# DNS-rebinding and browser-origin protection.
MADCP_ALLOWED_HOSTS=madcp.example.com,localhost,127.0.0.1
MADCP_ALLOWED_ORIGINS=https://madcp.example.com

# HEY -------------------------------------------------------------------------

MADCP_HEY_ALLOW_WRITE_METHODS=false
HEY_TIMEOUT=30
HEY_MAX_CHARS=12000

# Basecamp --------------------------------------------------------------------

MADCP_BASECAMP_ALLOW_WRITE_METHODS=false
BASECAMP_TOKEN=
BASECAMP_ACCOUNT_ID=
BASECAMP_TIMEOUT=30
BASECAMP_MAX_CHARS=12000

# Fatture in Cloud ------------------------------------------------------------

MADCP_FATTUREINCLOUD_ALLOW_WRITE_METHODS=false
FATTUREINCLOUD_TOKEN=
FATTUREINCLOUD_COMPANY_ID=
FATTUREINCLOUD_CLIENT_ID=
FATTUREINCLOUD_CLIENT_SECRET=
FATTUREINCLOUD_OAUTH_SCOPES=entity.clients:r entity.suppliers:r issued_documents.invoices:r archive:r
FATTUREINCLOUD_TIMEOUT=30
FATTUREINCLOUD_MAX_CHARS=12000
